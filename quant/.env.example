# AI 服务配置（OpenAI 兼容 chat/completions）
# 用法：复制本文件为 quant/.env ，按需修改后即生效。
# 注意：.env 已被 .gitignore 忽略，不会入库，请勿提交真实密钥。

# API 密钥（必填）
AI_API_KEY=your-api-key-here

# 服务地址（默认商汤 SensNews，OpenAI 兼容接口）
# 切换到 OpenAI 直连等即可改这里
AI_BASE_URL=https://token.sensenova.cn/v1/chat/completions

# 模型名
AI_MODEL=sensenova-6.7-flash-lite
